──────────────\r\n  44: CREATE TABLE icd9_chapters (\r\n  45:     id          INTEGER PRIMARY KEY,\r\n  46:     chapter_no  INTEGER NOT NULL,\r\n  47:     code_range  TEXT    NOT NULL,\r\n  48:     name        TEXT    NOT NULL,\r\n  49:     folder_name TEXT    NOT NULL,\r\n  50:     notes       TEXT\r\n  51: );\r\n  53: CREATE TABLE icd9_codes (\r\n  54:     id          INTEGER PRIMARY KEY,\r\n  55:     chapter_id  INTEGER NOT NULL REFERENCES icd9_chapters(id),\r\n  56:     code        TEXT    NOT NULL,        -- e.g. \"47.09\"\r\n  57:     name        TEXT    NOT NULL,\r\n  58:     category    TEXT,                    -- 类目 e.g. \"47\"\r\n  59:     notes       TEXT,\r\n  60:     FOREIGN KEY (chapter_id) REFERENCES icd9_chapters(id)\r\n  61: );\r\n  63: CREATE UNIQUE INDEX idx_icd9_code ON icd9_codes(code);\r\n  65: -- ── DRG 2.0 分组 ────────────────────────────────────────\r\n  67: CREATE TABLE drg_mdc (\r\n  68:     id          INTEGER PRIMARY KEY,\r\n  69:     mdc_code    TEXT    NOT NULL UNIQUE,   -- e.g. \"MDCF\"\r\n  70:     name        TEXT    NOT NULL,\r\n  71:     icd10_range TEXT                      -- 相关 ICD-10 范围\r\n  72: );\r\n  74: CREATE TABLE drg_adrg (\r\n  75:     id          INTEGER PRIMARY KEY,\r\n  76:     mdc_id      INTEGER NOT NULL REFERENCES drg_mdc(id),\r\n  77:     adrg_code   TEXT    NOT NULL UNIQUE,   -- e.g. \"FM3\"\r\n  78:     name        TEXT    NOT NULL,\r\n  79:     type        TEXT    NOT NULL CHECK(type IN ('surgical','medical','other')),\r\n  80:     FOREIGN KEY (mdc_id) REFERENCES drg_mdc(id)\r\n  81: );\r\n  83: CREATE TABLE drg_groups (\r\n  84:     id          INTEGER PRIMARY KEY,\r\n  85:     adrg_id     INTEGER NOT NULL REFERENCES drg_adrg(id),\r\n  86:     drg_code    TEXT    NOT NULL UNIQUE,   -- e.g. \"FM31\"\r\n  87:     name        TEXT    NOT NULL,\r\n  88:     severity    TEXT    NOT NULL CHECK(severity IN ('MCC','CC','noCC','unspecified')),\r\n  89:     weight      REAL,                      -- RW 值\r\n  90:     av